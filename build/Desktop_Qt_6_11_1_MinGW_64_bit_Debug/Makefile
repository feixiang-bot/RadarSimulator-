# target to build an object file
ui/radarwidget.cpp.obj:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\Radar_Simulator.dir\build.make CMakeFiles/Radar_Simulator.dir/ui/radarwidget.cpp.obj
	$(MAKE) $(MAKESILENT) -f CMakeFiles\demo_capture.dir\build.make CMakeFiles/demo_capture.dir/ui/radarwidget.cpp.obj
.PHONY : ui/radarwidget.cpp.obj

ui/radarwidget.i: ui/radarwidget.cpp.i
.PHONY : ui/radarwidget.i

# target to preprocess a source file
ui/radarwidget.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\Radar_Simulator.dir\build.make CMakeFiles/Radar_Simulator.dir/ui/radarwidget.cpp.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles\demo_capture.dir\build.make CMakeFiles/demo_capture.dir/ui/radarwidget.cpp.i
.PHONY : ui/radarwidget.cpp.i

ui/radarwidget.s: ui/radarwidget.cpp.s
.PHONY : ui/radarwidget.s

# target to generate assembly for a file
ui/radarwidget.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\Radar_Simulator.dir\build.make CMakeFiles/Radar_Simulator.dir/ui/radarwidget.cpp.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles\demo_capture.dir\build.make CMakeFiles/demo_capture.dir/ui/radarwidget.cpp.s
.PHONY : ui/radarwidget.cpp.s

